# Smart UoS E-Service backend settings.
# Copy to backend/.env (never committed) and fill in. Never put these values in the frontend.
# Real environment variables take precedence over this file.

# --- Required -------------------------------------------------------------------
# Connection for the dedicated backend role smart_uos_backend, which already exists in the
# shared project (NOT postgres, NOT the service_role key). Ask the project owner for it.
# Supabase pooler form: postgresql://smart_uos_backend.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=

# The shared Supabase project. Used to verify each staff member's session (Supabase Auth)
# and to download Incomplete Exam proof documents with that staff member's own session.
# Public anon key only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-public-key>

# Gemini API key. Required for every AI evaluation; without it, evaluations fail as
# technical failures (never as a recommendation).
GEMINI_API_KEY=

# --- Optional -------------------------------------------------------------------
# Primary Gemini model (default: gemini-3.6-flash).
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated fallback models, tried in order after a temporary Gemini error (HTTP 429
# or 503) on the previous model. Used by the Raise Capacity Prioritization Agent and both
# Incomplete Exam agents. (The Raise Capacity eligibility agent uses GEMINI_MODEL only; the
# Program Change agent uses its own fixed model list.) Empty = no fallback.
GEMINI_FALLBACK_MODELS=

# Comma-separated browser origins allowed to call the API (CORS).
# Default: http://localhost:5173 (the Vite development server).
FRONTEND_ORIGINS=http://localhost:5173
