# Copy to backend/.env (never committed) and fill in. Never put these in the frontend.

# Connection for the dedicated backend role smart_uos_backend, which already exists in the
# shared project (NOT postgres, NOT service_role). Ask the project owner for its details.
# Supabase pooler form: postgresql://smart_uos_backend.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=

# Used only to verify a signed-in user's session (Supabase Auth /auth/v1/user).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional, comma-separated. Used only by the priority agent, and only after a
# temporary Gemini error (429/503) on the previous model. Empty = no fallback.
GEMINI_FALLBACK_MODELS=

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173
