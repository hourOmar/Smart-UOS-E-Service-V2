# Smart UoS E-Service frontend settings.
# Copy to frontend/.env.local (never committed) and fill in, then restart `npm run dev`.
#
# Everything in this file is built into the browser bundle and is visible to users.
# Never put a secret here: no service_role key, database password, connection string
# or Gemini API key. Those belong only in backend/.env.

# --- Required -------------------------------------------------------------------
# The shared Supabase project (sign-in, database reads, database functions, Storage).
# Use the project's public anon key only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-public-key>

# --- Optional -------------------------------------------------------------------
# Base URL of the backend API (a public URL, not a secret). Leave empty in development:
# requests go to /api and the Vite dev server proxies them to http://127.0.0.1:8000.
# Set it only when the frontend is served separately from the backend, and add the
# frontend's origin to FRONTEND_ORIGINS in backend/.env.
VITE_API_BASE_URL=
