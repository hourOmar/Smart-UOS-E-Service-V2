# Copy to frontend/.env.local (never committed) and fill in.
# Everything here is built into the browser bundle: never put a secret,
# the service_role key or a database password in this file.

# Supabase project used for sign-in and reads (public anon key only).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-public-key>

# Optional. Base URL of the backend API. Leave empty in development: requests
# go to /api and the Vite dev server proxies them to the local backend.
VITE_API_BASE_URL=
